---
import Layout from '../layouts/Layout.astro';
import fs from 'fs';
import path from 'path';

const dataDir = path.join(process.cwd(), 'src', 'data');
const files = fs.readdirSync(dataDir).filter(file => {
  return /^\d{4}\.json$/.test(file);
});

const years = files
	.map(file => file.replace('.json', ''))
	.map(year => parseInt(year))
	.sort((a, b) => b - a);
---

<Layout title="Lists">
    <main>
	    <h1>All lists</h1>
	    <ul id="album-list">
	    {
		years.map((year) => (
		<li>
			<a href={`/${year}`}>{year}</a>
		</li>
		))
	    }
        </ul>
    </main>
</Layout>

<style>
	#album-list {
	    max-width: 1200px;
	    margin: 0 auto;
	    padding: 20px;
	    list-style: none;
	}

	h1 {
	    text-align: center;
	    color: #333;
	    margin-bottom: 40px;
	}
</style>

